{
  "name": "murasame-code",
  "version": "0.1.0",
  "description": "丛雨code —— 桌面端 AI 编程代理与千恋＊万花丛雨桌宠",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Waiwaitiyyt/murasame-code.git"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "murasame": "./bin/murasame.js"
  },
  "files": [
    "bin",
    "dist",
    "persona",
    "desktop",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "murasame",
    "cli",
    "coding-agent",
    "ai",
    "terminal",
    "anthropic",
    "openai"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint src test --ext .ts,.tsx",
    "format": "prettier --write src test",
    "prepublishOnly": "npm run build",
    "desktop": "electron .",
    "desktop:pet": "electron . --pet-only",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "openai": "^4.70.0",
    "react": "^18.3.1",
    "slice-ansi": "^7.1.2",
    "string-width": "^7.2.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.murasame.desktop",
    "productName": "丛雨code",
    "files": [
      "bin/**/*",
      "dist/**/*",
      "persona/**/*",
      "desktop/**/*",
      "!desktop/fgimages/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/fgimages",
        "to": "fgimages"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "desktop/assets/icon.ico",
      "uninstallerIcon": "desktop/assets/icon.ico",
      "installerHeaderIcon": "desktop/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "丛雨code",
      "runAfterFinish": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "zh_CN",
        "en_US",
        "ja_JP"
      ],
      "language": "2052",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "desktop/assets/icon.png"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
